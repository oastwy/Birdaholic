{
  "permissions": {
    "allow": [
      "Bash(/Users/wuyang/.flutter-sdk/bin/flutter analyze *)",
      "Bash(flutter analyze *)",
      "Bash(curl -sI *)",
      "Bash(claude mcp list *)",
      "Bash(scripts/build_android.sh *)",
      "Bash(scripts/build_harmony.sh *)",
      "Bash(scripts/build_ios.sh *)",
      "Bash(scripts/bump_version.sh *)",
      "Bash(scripts/release.sh *)",
      "mcp__fetch__fetch_markdown",
      "mcp__brave-search__brave_web_search"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard_commit.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard_build.sh" }
        ]
      }
    ]
  }
}
