#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Large generated and distributable assets
data_packs/*.zip
!data_packs/china_common_100_v1.0_opt.zip
*.apk
!releases/*.apk

# Local build and environment directories (not for version control)
.birdnet_engine_venv/
dist/
server_media_library/
server_media_library_optimized/
upload_batch/
import_lists/
/models/

# Android local SDK path config
android/local.properties

# Duplicate flutter plugin files (with spaces in name)
.flutter-plugins 2
.flutter-plugins-dependencies 2

# HarmonyOS(鸿蒙) 工程 + 签名材料：仅本机构建用，绝不提交（含 build-profile 加密密码/密钥）
/ohos/
/material/
*.p12
*.cer
*.csr
*.p7b
*.keystore

# 打包脚本切换 overrides 的瞬态文件
pubspec.yaml.tmp

# Flutter 工具重复生成的时间戳副本文件
.flutter-plugins *
.flutter-plugins-dependencies *
# 备份与内部记录
.git.pre_ref_recovery_*
*.bak_trim_*
.workbuddy/

# 构建产物不进 git（APK 发到服务器/GitHub Release，非仓库）
data_packs/
releases/
